config BOARD
    default "stm32h573i-dk" if BOARD_STM32H573I_DK

config BOARD_STM32H573I_DK
    bool
    default y
    select CPU_MODEL_STM32H573II

    # Clock configuration
    select BOARD_HAS_HSE
    select BOARD_HAS_LSE


config CLOCK_HSE
    default 25000000


source "$(RIOTBOARD)/common/stm32/Kconfig"
